# The live site's settings. None of these is a secret: the Firebase web config is sent to every
# browser anyway, and the bucket's name is in every tile URL. The two AWS keys are the only secrets,
# and they live in the host's environment (Vercel), never here. .env.local still overrides this file.

NEXT_PUBLIC_BACKEND=firebase

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyApzLJUvpNAUWkFOng7ipOVgzyP1_tz1J8
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=vpc-cartography.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=vpc-cartography
NEXT_PUBLIC_FIREBASE_APP_ID=1:829537020398:web:d33b4aa58ce1b85b46c6ff

IMAGE_STORE=s3
S3_BUCKET=cartography-maps
S3_REGION=eu-north-1

# S3 access with no stored key: Vercel's OIDC token is exchanged for this role (lib/image-store.ts).
AWS_ROLE_ARN=arn:aws:iam::197392266651:role/cartography-vercel
