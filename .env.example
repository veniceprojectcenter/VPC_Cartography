# Copy to .env.local and fill in, then restart `npm run dev`.

# ---------- rows and sign-in ----------
# csv       data/*.csv, one local admin below (the trial, the default)
# firebase  Firestore and Firebase Auth
NEXT_PUBLIC_BACKEND=csv

# csv: the one admin who can sign in and edit.
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=

# firebase: the web app's config from the Firebase console (Project settings → Your apps).
# For the local emulator use NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-cartography, any API key, and
# NEXT_PUBLIC_FIREBASE_EMULATORS=1 plus the two *_EMULATOR_HOST lines (the server checks tokens with them).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_EMULATORS=
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
# firebase on a real project: the server verifies sign-ins with a service-account key file.
GOOGLE_APPLICATION_CREDENTIALS=

# ---------- images ----------
# local  uploads/ in this folder, development only (the default)
# s3     the bucket below; see docs/architecture.md, Images, for its CORS and read policy
IMAGE_STORE=local
S3_BUCKET=
S3_REGION=
# Optional: a CDN in front of the bucket. Default: https://<bucket>.s3.<region>.amazonaws.com
S3_PUBLIC_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# On Vercel instead of the two keys: the role the function's OIDC token is exchanged for.
AWS_ROLE_ARN=
