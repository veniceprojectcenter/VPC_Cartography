{
  "name": "vpc-cartography",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-cartography --import .emulator-data --export-on-exit .emulator-data",
